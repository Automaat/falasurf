# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Optional: the production ID is baked in as the default (see Analytics.astro).
# Set this to override per-environment, or to "" to disable analytics entirely
# (no script, no cookies, no consent banner).
# Exposed to the client (PUBLIC_ prefix), so use the Measurement ID, never a secret.
PUBLIC_GA_ID=
